# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Encrypts each user's own Anthropic key before it is stored. Generate with: openssl rand -hex 32
# Keep it safe: if you lose or change it, saved user keys can no longer be read.
ENCRYPTION_KEY=

# Gmail SMTP — sends the briefing emails.
# GMAIL_APP_PASSWORD is a 16-character app password, not your normal password:
# Google Account → Security → 2-Step Verification → App passwords
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Secures the daily cron endpoint. Generate with: openssl rand -hex 32
CRON_SECRET=

# Optional: extra news coverage via newsapi.org
NEWSAPI_KEY=
